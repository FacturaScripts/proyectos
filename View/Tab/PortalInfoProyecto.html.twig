{% import 'Macro/PortalDoc.html.twig' as doc %}

{% set firstView = fsc.views | first %}
{% set proyecto = firstView.model %}

<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-body-secondary small">{{ trans('code') }}</div>
                <div class="pc-doc-total">{{ proyecto.nombre }}</div>

                <div class="mt-2 d-flex flex-wrap gap-2">
                    <span class="pc-badge-soft">{{ proyecto.getStatus().nombre }}</span>
                </div>

                <hr/>

                <div class="pc-doc-meta">
                    <div class="pc-doc-meta-row">
                        <span class="pc-doc-meta-label">{{ trans('date') }}</span>
                        <span class="pc-doc-meta-value">{{ proyecto.fecha }}</span>
                    </div>
                    {% if proyecto.fechainicio %}
                        <div class="pc-doc-meta-row">
                            <span class="pc-doc-meta-label">{{ trans('start-date') }}</span>
                            <span class="pc-doc-meta-value">{{ proyecto.fechainicio }}</span>
                        </div>
                    {% endif %}
                    {% if proyecto.fechafin %}
                        <div class="pc-doc-meta-row">
                            <span class="pc-doc-meta-label">{{ trans('end-date') }}</span>
                            <span class="pc-doc-meta-value">{{ proyecto.fechafin }}</span>
                        </div>
                    {% endif %}
                </div>

                <div class="mt-3">
                    {{ doc.actions(fsc, proyecto) }}
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <span class="pc-card-icon">
                    <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
                </span>
                <h2 class="h6 mb-0">{{ trans('description') }}</h2>
            </div>
            <div class="card-body">
                <p class="mb-0">{{ proyecto.descripcion | raw | nl2br }}</p>
            </div>
        </div>
    </div>
</div>
